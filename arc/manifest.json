{
  "manifest_version": 3,
  "name": "My Calendar Grouping",
  "version": "1.4.2",
  "description": "Googleカレンダーのカレンダーをグループ単位で切り替えるChrome拡張機能",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": ["https://calendar.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
